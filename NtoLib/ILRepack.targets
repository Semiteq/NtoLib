<Project>
  <!--
    Custom ILRepack target for NtoLib.
    Imported automatically by ILRepack.Lib.MSBuild.Task.targets via the
    $(ILRepackTargetsFile) property declared in NtoLib.csproj. Presence of this
    file also suppresses the package's default ILRepack target, allowing this
    project-specific configuration (vendor SDK exclusions, Resources probe path)
    to take effect.
  -->
  <!--
    Gated on $(RunILRepack)=true so ordinary `dotnet build` does not internalize
    NuGet types into NtoLib.dll. Internalisation collides with the test build
    because NtoLib carries [InternalsVisibleTo("Tests")] and Tests references the
    same NuGet packages directly; CS0433 ambiguity follows. release.yml (and locally
    Build/Deploy.ps1) invokes a final `dotnet build /p:RunILRepack=true` after the test
    step to produce the merged release artifact.
  -->
  <Target Name="ILRepacker" AfterTargets="Build" Condition="'$(RunILRepack)' == 'true'">
    <ItemGroup>
      <!--
        Vendor SDK references (FB, InSAT.*, MasterSCADA*, ICSharpCode.*, OpcUaClient,
        Opc.Ua.Core, COMDeviceSDK) all carry <Private>False</Private> in NtoLib.csproj,
        so MSBuild does not copy them to $(OutputPath) and the *.dll glob normally cannot
        pick them up. The vendor-name patterns below are belt-and-suspenders defense
        against stale binaries in $(OutputPath) (older builds, manual copies) that the
        glob would otherwise sweep into the merge.

        The remaining exclude is for an assembly that DOES legitimately land in
        $(OutputPath) but must not be merged:
        System.Resources.Extensions (resx loader, breaks if internalised).

        System.Text.Json + System.Text.Encodings.Web are intentionally NOT excluded:
        they are merged and internalised into NtoLib.dll. A private copy of the
        built-against version lives inside the assembly, so the merged DLL carries no
        external strong-name reference to them and does not depend on the host supplying
        System.Text.Json. Safe because these types are used only internally (OpcTreeManager
        snapshot read/write) and never cross the COM boundary to the host. ILRepack emits
        modreq(IsExternalInit) warnings for STJ's init-only record setters during this
        merge; the merged types load and run, the warnings are benign.
      -->
      <ILRepackInputAssemblies Include="$(OutputPath)NtoLib.dll" />
      <ILRepackInputAssemblies Include="$(OutputPath)*.dll"
        Exclude="$(OutputPath)NtoLib.dll;
                 $(OutputPath)FB.dll;
                 $(OutputPath)InSAT.*.dll;
                 $(OutputPath)MasterSCADA*.dll;
                 $(OutputPath)ICSharpCode.*.dll;
                 $(OutputPath)OpcUaClient.dll;
                 $(OutputPath)Opc.Ua.Core.dll;
                 $(OutputPath)COMDeviceSDK.dll;
                 $(OutputPath)System.Resources.Extensions.dll" />
      <ILRepackLibraryPath Include="$(OutputPath)" />
      <ILRepackLibraryPath Include="$(MSBuildProjectDirectory)\..\Resources" />
    </ItemGroup>
    <ILRepack
      Parallel="true"
      Internalize="true"
      InputAssemblies="@(ILRepackInputAssemblies)"
      OutputFile="$(OutputPath)NtoLib.dll"
      LibraryPath="@(ILRepackLibraryPath)" />
  </Target>
</Project>
